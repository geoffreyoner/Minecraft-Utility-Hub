PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Cloudflare Turnstile
CF_SECRET_KEY=
# Set true HANYA di mesin development lokal untuk melewati verifikasi Turnstile
TURNSTILE_BYPASS=false

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Server
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=false
